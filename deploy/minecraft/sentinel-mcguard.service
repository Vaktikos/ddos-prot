[Unit]
Description=Sentinel Shield Minecraft guard
Documentation=https://github.com/vaktikos/ddos-prot/blob/main/docs/MINECRAFT.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/sentinel-mcguard --config /etc/sentinel-shield/mcguard.json
Restart=always
RestartSec=2
DynamicUser=yes
# Port 25565 is above 1023 but the guard may be asked to listen on a lower one.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
# One descriptor per client plus one per backend connection.
LimitNOFILE=65536
ReadOnlyPaths=/etc/sentinel-shield
SyslogIdentifier=sentinel-mcguard

[Install]
WantedBy=multi-user.target
