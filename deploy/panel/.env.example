# Sentinel Shield panel configuration. Copy to deploy/panel/.env and fill in the
# placeholders. The .env file contains secrets and must never be committed.
# Generate secrets with: openssl rand -base64 32

# Public URL that browsers and agents use. Must be https (http only for localhost).
PANEL_PUBLIC_URL=https://panel.example.net:8443

# PostgreSQL. The password must be unique per installation.
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=CHANGE_ME_generate_with_openssl
PANEL_DATABASE_URL=host=postgres port=5432 dbname=sentinel user=sentinel password=CHANGE_ME_generate_with_openssl sslmode=disable

# TLS certificate files, mounted read-only into the panel container.
# Use a certificate from your CA or Let's Encrypt; do not run the panel without TLS.
PANEL_TLS_CERT=/run/secrets/panel-cert.pem
PANEL_TLS_KEY=/run/secrets/panel-key.pem
PANEL_HOST_PORT=8443

# First administrator. The password is read from a file, not from the environment.
PANEL_ADMIN_EMAIL=admin@example.net
PANEL_ADMIN_PASSWORD_FILE=/run/secrets/admin-password.txt

PANEL_SESSION_HOURS=12

# --- Optional: signing key in an HSM/KMS or Vault (default: key file in the panel's data volume) ---
# PANEL_SIGNER=file|command|vault
# command: JSON array; the program reads the message on stdin and prints the signature (base64)
# PANEL_SIGNER_COMMAND=["/usr/local/bin/kms-sign"]
# PANEL_SIGNER_PUBLIC_KEY=BASE64_ED25519_PUBLIC_KEY
# vault (Transit engine):
# PANEL_VAULT_ADDR=https://vault.example.net:8200
# PANEL_VAULT_TOKEN_FILE=/run/secrets/vault-token
# PANEL_VAULT_MOUNT=transit
# PANEL_VAULT_KEY=sentinel-policy
# PANEL_VAULT_KEY_VERSION=0
# Required with an external signer: key material for stored MFA secrets
# PANEL_DATA_KEY_FILE=/run/secrets/data-key
# During a signing key rotation: public key of the new key
# PANEL_NEXT_SIGNING_PUBLIC_KEY=BASE64_ED25519_PUBLIC_KEY
